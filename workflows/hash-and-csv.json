{
	"name": "DevTools — JSON to CSV, then hash it",
	"nodes": [
		{
			"parameters": {},
			"id": "c2b8f1d0-0001-4b00-8000-000000000001",
			"name": "When clicking 'Test workflow'",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [240, 300]
		},
		{
			"parameters": {
				"resource": "convert",
				"operation": "jsonToCsv",
				"records": "[\n  { \"id\": 1, \"city\": \"Dubai\" },\n  { \"id\": 2, \"city\": \"Abu Dhabi\" }\n]",
