				"data": "={{ $json.csv }}",
				"hashAlgorithm": "sha256",
				"encoding": "hex"
			},
			"id": "c2b8f1d0-0003-4b00-8000-000000000003",
			"name": "SHA-256 of CSV",
			"type": "n8n-nodes-devtools.devTools",
			"typeVersion": 1,
			"position": [720, 300]
		}
	],
	"connections": {
		"When clicking 'Test workflow'": {
			"main": [[{ "node": "JSON to CSV", "type": "main", "index": 0 }]]
		},
		"JSON to CSV": {
			"main": [[{ "node": "SHA-256 of CSV", "type": "main", "index": 0 }]]
		}
	},
	"settings": { "executionOrder": "v1" }
